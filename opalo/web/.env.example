# Copia este archivo a .env.local y llena los datos de tu proyecto de Supabase.
# Sin estas variables, `npm run dev` arranca en MODO DEMOSTRACIÓN (datos sólo en el navegador) y
# `npm run build` genera un sitio que avisa que no está configurado (nunca cae en la demo).
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key
